# ---------- Core ----------
# Public URL of the web app (no trailing slash)
APP_URL=http://localhost:3000
DATABASE_URL=postgres://etr:etr@localhost:5432/easytoreach
REDIS_URL=redis://localhost:6379

# 32-byte base64 key that encrypts OAuth tokens at rest. Generate: pnpm gen:key
# Never change it without a rotation (see README) or stored tokens become unreadable.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# ---------- Auth.js (login) ----------
# Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Phase 1 is single-user: only these emails may sign in (comma separated)
ALLOWED_EMAILS=you@yourdomain.com

# ---------- Google OAuth (one Google Cloud client used for login AND Connect Gmail) ----------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
